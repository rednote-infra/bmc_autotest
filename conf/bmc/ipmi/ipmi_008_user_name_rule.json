{
    "IpmiUserNameRule": {
        "TestName": "IPMI带外用户名规则校验（4~16位全英文字母）",
        "TestNum": "IPMI_User_003",
        "LogBasename": "ipmi_008_user_name_rule",
        "BMC_IP": "",
        "UserName": "",
        "PassWord": "",
        "IpmiInterface": "lanplus",
        "QueryTimeoutSec": 30,
        "QueryChannel": 1,
        "TestUserId": 5,
        "WaitAfterOpSec": 1,
        "CleanupName": "unusedslot",
        "CleanupPriv": 15,
        "_comment_rules": "分类规范与 account_007_username_rule_test 保持一致：正向=4~16位全英文字母应成功；长度越界（3位/17位）为宽松项，未拦截记 WARNING 不 FAIL；字符集违规（含数字/特殊字符等）为严格项，未拦截 → FAIL（本用例暂未覆盖，见 account_007）",
        "PositiveCases": [
            {
                "name": "abcd",
                "desc": "4位（最短，全小写）",
                "expect": "pass"
            },
            {
                "name": "abcdefghijklmnop",
                "desc": "16位（最长，全小写）",
                "expect": "pass"
            },
            {
                "name": "ABCDEFGH",
                "desc": "8位全大写",
                "expect": "pass"
            },
            {
                "name": "MixedCase",
                "desc": "混合大小写",
                "expect": "pass"
            }
        ],
        "NegativeWarnIfPass": [
            {
                "name": "abc",
                "desc": "3位（低于下限4位，未拦截记WARNING）",
                "expect": "fail"
            },
            {
                "name": "abcdefghijklmnopq",
                "desc": "17位（超过上限16位，未拦截记WARNING）",
                "expect": "fail"
            }
        ],
        "NegativeMustFail": []
    }
}