{
    "IpmiUserPasswordRule": {
        "TestName": "IPMI带外密码复杂度规则校验（大小写+数字+特殊字符，≥8位）",
        "TestNum": "IPMI_User_004",
        "LogBasename": "ipmi_009_user_password_rule",
        "BMC_IP": "",
        "UserName": "",
        "PassWord": "",
        "IpmiInterface": "lanplus",
        "QueryTimeoutSec": 30,
        "QueryChannel": 1,
        "TestUserId": 5,
        "WaitAfterOpSec": 1,
        "CleanupName": "unused_5",
        "CleanupPriv": 15,
        "PositiveCases": [
            {
                "password": "Ab1@5678",
                "desc": "8位合规（最短）"
            },
            {
                "password": "Ab1@56789012",
                "desc": "12位合规"
            }
        ],
        "NegativeMustFail": [
            {
                "password": "Ab1@567",
                "desc": "7位过短（<8位，必须拦截）"
            },
            {
                "password": "Abcd1234",
                "desc": "无特殊字符（必须拦截）"
            },
            {
                "password": "abcdefgh",
                "desc": "纯小写无数字无特殊字符（必须拦截）"
            },
            {
                "password": "12345678",
                "desc": "纯数字（必须拦截）"
            }
        ],
        "NegativePassIfAccepted": [
            {
                "password": "Ab1@5678901234",
                "desc": "13位（超需求上限，位数更高更安全，BMC接受=PASS）"
            }
        ]
    }
}